{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/agent_hook.py\"",
            "timeout": 90,
            "statusMessage": "Checking the edited file (tools/check.py)"
          }
        ]
      }
    ]
  }
}
