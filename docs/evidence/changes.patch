+        document.build(story,onFirstPage=page,onLaterPages=page)
+        os.replace(temporary,TARGET)
+    finally:
+        Path(temporary).unlink(missing_ok=True)
+    print(f"Wrote {TARGET}")
+
+
+if __name__=="__main__":main()
