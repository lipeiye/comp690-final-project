#!/bin/sh
# Block a commit that adds lint debt, breaks formatting, edits a pinned file or breaks a
# project invariant. Unit tests run in CI (tools/check.py without --fast).
# Enabled by `git config core.hooksPath .githooks`; skip once with `git commit --no-verify`.
exec python3 "$(git rev-parse --show-toplevel)/tools/check.py" --fast
